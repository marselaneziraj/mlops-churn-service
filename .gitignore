# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Data + models are tracked by DVC, not Git
/data/raw/*
/data/processed/*
/data/reference/*
!/data/**/.gitkeep
!/data/**/*.dvc
/models/*
!/models/.gitkeep

# Experiment tracking
mlruns/
mlartifacts/
mlflow.db

# Generated reports (regenerable)
/reports/*
!/reports/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
*.log
